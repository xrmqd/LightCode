#!/usr/bin/env python3
"""Select the production release metadata for a main-branch CI build."""

import os
from pathlib import Path
import subprocess
import tomllib


def main():
    if (os.environ["GITHUB_REF_TYPE"], os.environ["GITHUB_REF_NAME"]) != ("branch", "main"):
        raise SystemExit("Cloud releases are built only from main. Build development branches locally.")

    repo = Path(__file__).resolve().parent.parent
    version = tomllib.loads((repo / "Cargo.toml").read_text())["workspace"]["package"]["version"]
    run_number = os.environ["GITHUB_RUN_NUMBER"]
    if not run_number.isdecimal() or int(run_number) < 1:
        raise ValueError("GITHUB_RUN_NUMBER must be a positive integer")

    tag = f"v{version}+build.{run_number}"
    subprocess.run(["git", "check-ref-format", f"refs/tags/{tag}"], cwd=repo, check=True)
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip()
    outputs = {
        "tag": tag,
        "title": f"LightCode {version} (build {run_number})",
        "commit": commit,
    }
    environment = {
        "LIGHTCODE_RELEASE_TAG": tag,
        "LIGHTCODE_RELEASE_CHANNEL": "stable",
        "GRAM_RELEASE_CHANNEL": "stable",
    }
    for destination, values in (("GITHUB_OUTPUT", outputs), ("GITHUB_ENV", environment)):
        with Path(os.environ[destination]).open("a") as stream:
            for key, value in values.items():
                stream.write(f"{key}={value}\n")
    print(f"release/stable: {tag}")


if __name__ == "__main__":
    main()
