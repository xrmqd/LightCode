#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
icon_path="$repo_root/crates/gram/resources/AppIcon.icon"
output_path="${1:-$repo_root/target/app-icon-assets}"
plist_path="$output_path/assetcatalog_generated_info.plist"

python3 "$repo_root/script/validate-app-icon" "$icon_path"
mkdir -p "$output_path"

# The asset name must match both the .icon filename and CFBundleIconName.
xcrun actool "$icon_path" --compile "$output_path" \
  --output-format human-readable-text --notices --warnings --errors \
  --output-partial-info-plist "$plist_path" \
  --app-icon AppIcon --include-all-app-icons \
  --enable-on-demand-resources NO \
  --development-region en \
  --target-device mac \
  --minimum-deployment-target 26.0 \
  --platform macosx </dev/null

test -s "$output_path/Assets.car"
test -s "$plist_path"
