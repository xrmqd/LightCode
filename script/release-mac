#!/bin/bash
set -eux
version="$1"

bundle_target() {
  arch="$1"
  target="$arch-apple-darwin"
  cargo clean
  ./script/bundle-mac $target
  cp target/$target/release/LightCode-$arch.dmg ../lightcode-$version/LightCode-$arch-$version.dmg
  cp target/lightcode-remote-server-macos*.gz ../lightcode-$version/lightcode-remote-server-macos-${arch}-${version}.gz
}

[ -d ../lightcode-$version ] || {
  echo "../lightcode-$version does not exist" >&2
  exit 1
}
bundle_target aarch64
bundle_target x86_64
